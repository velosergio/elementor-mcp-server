{
	"name": "elementor-mcp/elementor-mcp",
	"description": "Open-source WordPress MCP server and Elementor MCP server plugin with safe, typed AI automation.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.5",
		"automattic/jetpack-autoloader": "^6.0",
		"league/oauth2-server": "^9.4",
		"nyholm/psr7": "^1.8",
		"wordpress/mcp-adapter": "^0.7.0"
	},
	"require-dev": {
		"carthage-software/mago": "^1.24.0",
		"php-stubs/generator": "^0.9.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"phpunit/phpunit": "^13.0"
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true
		},
		"sort-packages": true
	},
	"scripts": {
		"analyze": "mago analyze --baseline mago-analysis-baseline.toml --verify-baseline",
		"lint": "mago lint --baseline mago-lint-baseline.toml --verify-baseline",
		"test": "phpunit"
	}
}
